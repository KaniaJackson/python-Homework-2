5.def fahrenheit_to_kelvin(fahrenheit):

  celsius = (fahrenheit - 32) * (5 / 9)

  return celsius + 273.15

# Example usage:

temp_f = 98.6

print(f"{temp_f} °F is {fahrenheit_to_kelvin(temp_f):.2f} K")
